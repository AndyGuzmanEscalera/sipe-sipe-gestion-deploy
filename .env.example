# Copiar a .env y editar antes de `docker compose up`.
#   cp .env.example .env
#
# IMPORTANTE: este archivo es sólo una plantilla. No contiene secretos reales.
# El servidor debe generar sus propios valores.

# ---------------------------------------------------------------------------
# Entorno
# ---------------------------------------------------------------------------
# production: exige COOKIE_SECURE=true y PUBLIC_BASE_URL con https y sin
# localhost (el backend se niega a arrancar si no se cumple).
APP_ENV=production
APP_NAME=sipe-sipe-gestion-api
APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# PostgreSQL (base propia: gestion_sipe)
# ---------------------------------------------------------------------------
POSTGRES_DB=gestion_sipe
POSTGRES_USER=sipe_app
# OBLIGATORIO: generar en el servidor una contraseña fuerte e independiente.
#   openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIAR_EN_SERVIDOR
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL la compone docker-compose con POSTGRES_*; no se define aquí.

# Puertos publicados en el host, ligados a 127.0.0.1.
# BACKEND_PORT es el destino local de Cloudflare Tunnel.
BACKEND_PORT=8001
GESTION_POSTGRES_PORT=5433

# Nombres de contenedor (sólo si conviven con otra instancia en el mismo host).
GESTION_DB_CONTAINER=sipe_gestion_db
GESTION_BACKEND_CONTAINER=sipe_gestion_backend

# ---------------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------------
# OBLIGATORIO: generar el secreto directamente en el servidor.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Mínimo 32 caracteres: el backend se niega a arrancar con un valor más corto.
JWT_ACCESS_SECRET=GENERAR_EN_SERVIDOR
JWT_ISSUER=sipe-sipe-gestion-api
JWT_AUDIENCE=sipe-sipe-gestion-admin
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Cookies de sesión (refresco)
# ---------------------------------------------------------------------------
COOKIE_NAME=gestion_refresh_token
COOKIE_PATH=/api/admin/auth
# Obligatorio true en producción (HTTPS).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Orígenes permitidos del panel administrativo. Formato: lista separada por
# comas (así lo parsea backend/app/core/config.py).
# Durante la transición se permiten ambos; después se puede retirar pages.dev.
CORS_ALLOW_ORIGINS=https://sipesipe-gestion.pages.dev,https://gestion.sipesipe.gob.bo
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# Almacenamiento de archivos
# ---------------------------------------------------------------------------
# Ruta dentro del contenedor. Los archivos viven en el volumen gestion_storage.
STORAGE_ROOT=/app/storage
MAX_PDF_SIZE_MB=25
MAX_IMAGE_SIZE_MB=8

# ---------------------------------------------------------------------------
# URL pública del backend
# ---------------------------------------------------------------------------
# Es la base de las URLs de media que consume el sitio público y el valor que
# Cloudflare Tunnel publica. Debe ser la URL pública real y con https.
PUBLIC_BASE_URL=https://api.sipesipe.gob.bo
